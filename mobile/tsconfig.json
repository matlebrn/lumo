{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@moteur": [
        "../packages/moteur/moteur"
      ],
      "@outils": [
        "../packages/moteur/outils"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../packages/moteur/moteur.d.ts",
    "../packages/moteur/outils.d.ts"
  ]
}